extend input UpdateEscalationPolicyInput {
  "Confirmation bound to the complete update input and current state."
  confirmation: DeletionSafetyConfirmationInput
}

extend input UpdateEscalationPolicyStepInput {
  confirmation: DeletionSafetyConfirmationInput
}

extend input ScheduleTargetInput {
  confirmation: DeletionSafetyConfirmationInput
}

extend input UpdateRotationInput {
  confirmation: DeletionSafetyConfirmationInput
}

extend input UpdateServiceInput {
  confirmation: DeletionSafetyConfirmationInput
}

"Preview of relationship changes; the business root remains present."
type UpdateDeletionPreview {
  operation: DeletionOperation!
  root: DeletionResource!
  impactVersion: ID!
  policyVersion: String!
  complete: Boolean!
  canProceed: Boolean!
  requiresConfirmation: Boolean!
  removed: [DeletionResource!]!
  impacts: [DeletionImpact!]!
}

extend type Query {
  previewUpdateEscalationPolicy(input: UpdateEscalationPolicyInput!): UpdateDeletionPreview!
  previewUpdateEscalationPolicyStep(input: UpdateEscalationPolicyStepInput!): UpdateDeletionPreview!
  previewUpdateScheduleTarget(input: ScheduleTargetInput!): UpdateDeletionPreview!
  previewUpdateRotation(input: UpdateRotationInput!): UpdateDeletionPreview!
  previewUpdateService(input: UpdateServiceInput!): UpdateDeletionPreview!
}
